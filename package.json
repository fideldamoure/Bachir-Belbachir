{
  "name": "tlemcen-tawdhif-app",
  "version": "1.0.0",
  "private": true,
  "description": "نظام الرقابة والتدقيق لمسابقات التوظيف - ولاية تلمسان",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o www/vendor/tailwind.css --minify",
    "prepare:www": "node scripts/prepare-www.js",
    "build": "npm run prepare:www && npm run build:css",
    "sync": "npm run build && npx cap sync android",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/core": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/share": "latest",
    "@fontsource/cairo": "^5.0.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "tailwindcss": "^3.4.0"
  }
}
